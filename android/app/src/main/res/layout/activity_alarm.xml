<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#042F2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Badge -->
        <TextView
            android:id="@+id/tvAlarmBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDICATION REMINDER"
            android:textColor="#2DD4BF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:background="#134E4A"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Large Scheduled Time -->
        <TextView
            android:id="@+id/tvAlarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAlarmStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="It's time for your scheduled dose"
            android:textColor="#99F6E4"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Card with Medication / Hydration Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#134E4A"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/tvAlarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medication Name"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAlarmBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dosage &amp; Instructions"
                android:textColor="#CCFBF1"
                android:textSize="16sp"
                android:textAlignment="center"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- Action Button 1: CONFIRM TAKEN / LOG DRANK -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✓ CONFIRM TAKEN"
            android:textColor="#042F2E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#2DD4BF"
            android:layout_marginBottom="14dp" />

        <!-- Action Button 2: SNOOZE 10 MIN -->
        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⏰ SNOOZE 10 MIN"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#0F766E"
            android:layout_marginBottom="12dp" />

        <!-- Action Button 3: DISMISS -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="✕ DISMISS"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:background="#042F2E" />

    </LinearLayout>
</ScrollView>
