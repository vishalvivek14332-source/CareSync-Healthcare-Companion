# ==============================================================================
# CareSync Production Environment Configuration (.env.production.example)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=443

# PostgreSQL Production Database (AWS RDS, Supabase, Neon, or Cloud SQL)
DATABASE_URL=postgresql://caresync_admin:REPLACE_WITH_STRONG_PASSWORD@prod-db.example.internal:5432/caresync_prod?sslmode=require

# JWT Cryptographic Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_64_HEX_CHARACTERS_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_64_HEX_CHARACTERS_FOR_REFRESH_TOKEN

# CORS Allowed Origins (Comma-separated HTTPS origins)
CORS_ALLOWED_ORIGINS=https://app.caresync.com,capacitor://localhost

# Frontend API URL (Configured during Android & Web build)
VITE_API_URL=https://api.caresync.com

# Firebase Cloud Messaging (FCM Server Key for Push Notifications)
FCM_SERVER_KEY=REPLACE_WITH_FIREBASE_CLOUD_MESSAGING_SERVER_KEY

# Object Storage for Avatars / Attachments (AWS S3, Cloudflare R2, or MinIO)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=caresync-production-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY

# Optional Gemini AI Companion API Key
GEMINI_API_KEY=
