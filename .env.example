# ==============================================================================
# CareSync Environment Configuration (.env.example)
# ==============================================================================

# Server Environment (development, staging, production)
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL in production, SQLite in dev fallback)
DATABASE_URL=postgresql://caresync_user:secure_password@postgres-host:5432/caresync_prod?sslmode=require

# JWT Cryptographic Secrets (Use `openssl rand -hex 64` to generate)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_here

# CORS Allowed Origins (Comma-separated HTTPS domains)
CORS_ALLOWED_ORIGINS=https://app.caresync.com,capacitor://localhost,http://localhost:3000

# Frontend API URL (Used during Vite build)
VITE_API_URL=https://api.caresync.com

# Firebase Cloud Messaging (For Server-Originated Push Notifications)
FCM_SERVER_KEY=your_fcm_server_key_or_service_account_json

# Object Storage for Avatars / Attachments (s3, gcs, or local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=caresync-patient-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional AI Assistant API Key
GEMINI_API_KEY=
